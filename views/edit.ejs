<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Page</title>
</head>
<body>
    <div class="edit-post">
     <form action="/posts/<%=post.id%>?_method=PATCH" method="post">
    <input type="text" name="caption" id="caption" value="<%= post.caption %>" placeholder="Enter caption">
    <input type="text" name="imageUrl" id="imageUrl" value="<%= post.imageUrl %>" placeholder="Enter image URL">
    <button type="submit">Edit</button>
    </form>
</body>
</html>