<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Page</title>
</head>
<body>
     <div class="show-post">
     <h1>Post id: <%= post.id %></h1>
     <p>Post Caption is: <%=post.caption %></p>

     <img src="<%= post.imageUrl %>" alt="">
     <p>Post Created At: <%=  new Date(post.createdAt).toLocaleString() %> </p>
     </div>
</body>
</html>